# Sokher Store Environment Variables

# Shared PostgreSQL Database (Supabase, Neon, Railway, or local PostgreSQL)
# Example: postgresql://postgres:yourpassword@db.supabase.co:5432/postgres
# Leave empty for zero-setup local development
DATABASE_URL=""

# Authentication Secret (Used for signing server-side JWT session cookies)
JWT_SECRET="sokher_store_super_secret_jwt_key_2026_change_in_production"

# Default Admin Credentials (Created during seeding)
ADMIN_NAME="Sokher Store Admin"
ADMIN_EMAIL="admin@sokherstore.com"
ADMIN_PASSWORD="admin123456"

# AI Integration (Optional: Google Gemini API Key for AI Assistant & Descriptions)
GEMINI_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
